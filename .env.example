# Copy to .env (which git ignores) and fill in. Every run reads it, so changes apply
# from the next backup, without rebuilding or re-running setup.

# The Photos library to back up. Photos → Settings → General shows where it is; the
# default is ~/Pictures/Photos Library.photoslibrary.
PHOTOS_LIBRARY="/Volumes/External/Photos Library.photoslibrary"

# Optional: a healthchecks.io ping URL, so you hear about backups that fail or don't
# run (see README → Monitoring). Keep it private; anyone with it can send pings.
HEALTHCHECK_URL=
